# Configurações do Supabase
SUPABASE_URL=https://sua-instancia.supabase.co
SUPABASE_ANON_KEY=sua-chave-anonima
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
DATA_SOURCE=supabase
PORT=3001

# Configurações de Envio de E-mail (SMTP)
# Suporta Office 365 (smtp.office365.com / porta 587), Google Workspace ou SMTP próprio Videplast
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@videplast.com.br
SMTP_PASS=sua-senha-ou-app-password
EMAIL_FROM=sistema.mrp@videplast.com.br

# Destinatários do Fluxo de Solicitações (Filial -> Matriz)
EMAIL_ALMOXARIFADO=almoxarifado@videplast.com.br
EMAIL_SUPERVISOR=supervisor@videplast.com.br
EMAIL_COORDENADOR=coordenador@videplast.com.br
EMAIL_MATRIZ=responsavel.matriz@videplast.com.br
